# Local development. Run `scripts/init-env.sh` to create .env with random values; never commit .env.
# Production does not use this file: it reads the same parameter names from AWS SSM Parameter Store.
BIONEXUS_RUN_BUDGET_USD=10
BIONEXUS_RUN_WARN_USD=5
BIONEXUS_RUN_MAX_CALLS=40
BIONEXUS_TENANT_MONTHLY_USD=200
# fixture = offline synthetic demo (Crohn's only). live = real public databases (any disease).
BIONEXUS_SOURCES=fixture
BIONEXUS_INLINE_WORKER=1
BIONEXUS_TEST_DSN=
DEV_ADMIN_TOKEN=
DEV_SCIENTIST_TOKEN=
SESSION_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
